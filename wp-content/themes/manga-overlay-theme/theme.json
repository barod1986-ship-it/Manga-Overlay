{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        { "slug": "ink", "name": "Ink", "color": "#171713" },
        { "slug": "paper", "name": "Paper", "color": "#f4f0e6" },
        { "slug": "paper-bright", "name": "Bright paper", "color": "#fffdf7" },
        { "slug": "vermillion", "name": "Vermillion", "color": "#dd3e2b" },
        { "slug": "pine", "name": "Pine", "color": "#215b52" },
        { "slug": "sand", "name": "Sand", "color": "#d8ccb7" }
      ]
    },
    "layout": {
      "contentSize": "760px",
      "wideSize": "1240px"
    },
    "spacing": {
      "spacingSizes": [
        { "slug": "20", "name": "2XS", "size": "0.375rem" },
        { "slug": "30", "name": "XS", "size": "0.625rem" },
        { "slug": "40", "name": "S", "size": "1rem" },
        { "slug": "50", "name": "M", "size": "1.5rem" },
        { "slug": "60", "name": "L", "size": "2.25rem" },
        { "slug": "70", "name": "XL", "size": "3.5rem" }
      ],
      "units": ["px", "rem", "em", "%", "vw"]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "interface",
          "name": "Arabic interface",
          "fontFamily": "Tahoma, Arial, 'Noto Sans Arabic', sans-serif"
        },
        {
          "slug": "display",
          "name": "Display",
          "fontFamily": "Arial Black, Tahoma, Arial, sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "0.8125rem" },
        { "slug": "medium", "name": "Medium", "size": "1rem" },
        { "slug": "large", "name": "Large", "size": "1.375rem" },
        { "slug": "x-large", "name": "Extra large", "size": "2.25rem" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|paper",
      "text": "var:preset|color|ink"
    },
    "spacing": {
      "blockGap": "1.25rem"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|interface",
      "fontSize": "var:preset|font-size|medium",
      "lineHeight": "1.75"
    }
  }
}

