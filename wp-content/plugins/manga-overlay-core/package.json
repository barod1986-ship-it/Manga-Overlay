{
  "name": "@mol/editor-shell",
  "version": "0.10.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "check": "npm run test && npm run build",
    "dev": "vite --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test --config=tests/editor.playwright.config.ts"
  },
  "dependencies": {
    "@mol/poc-renderer": "0.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-moveable": "0.56.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
